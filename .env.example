# Environment mode (development or production)
NODE_ENV=

# Host to bind the HTTP server to (e.g. 127.0.0.1 or 0.0.0.0)
HOST=

# Port to listen on (default 4173)
PORT=

# Directory where SQLite database and file uploads are stored
DATA_DIR=

# Full path to SQLite database file (overrides DATA_DIR)
DB_PATH=

# Path to the Chrome or Chromium executable used for PDF rendering
CHROME_PATH=

# Disable Chromium sandbox (set to true in root container environments)
CHROME_NO_SANDBOX=

# Stable secret for HMAC signing of guest session cookies (min 32 characters)
GUEST_COOKIE_SECRET=

# Guest report retention duration in hours before automatic deletion
GUEST_RETENTION_HOURS=

# User report retention duration in days
USER_RETENTION_DAYS=
